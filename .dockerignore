# Keep the build context clean: dependencies are installed inside the image,
# and a host node_modules copied over them would break the pnpm symlink store.
node_modules
**/node_modules
**/.next
.git
# Agent tooling, the Impeccable detector binary among it: nothing a build reads.
.claude
vendors
provision/.env
**/.env*
# Nothing of the tests reaches an image: test files and folders, the drivers,
# the use case suite and its language (scripts/check-image-content.mjs checks
# every image built in CI).
**/*.test.*
**/*.spec.*
**/test
**/driver
packages/use-cases
packages/use-case-language
