{
  "name": "abacus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:reset": "scripts/db-reset.sh",
    "db:test:env": "node scripts/test-db.mjs env",
    "data:seed": "node --env-file=apps/web/.env.local packages/data-seed/src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "migrate": "node packages/core/src/db/migrate.ts",
    "migrate:dev": "DATABASE_URL=postgresql://abacus:abacus@127.0.0.1:5544/abacus node packages/core/src/db/migrate.ts",
    "test": "pnpm run test:repo && pnpm --recursive test",
    "test:repo": "node --env-file-if-exists=.env.test --import ./scripts/test-preload.mjs --test-global-setup=./scripts/test-market.mjs --test 'scripts/*.test.mjs' 'speckit/extensions/*/test/*.test.mjs'",
    "typecheck": "tsc --noEmit && pnpm --filter @abacus/web typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.1.2",
    "agent-browser": "0.39.1",
    "typescript": "^7.0.2"
  }
}
