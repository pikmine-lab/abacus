node_modules/
.next/
out/
dist/

# Written by Next.js, and not the same twice: `next dev` points it at
# .next/dev/types while `next build` points it at .next/types, so a tracked copy
# flips with whichever ran last. Next's own docs say to keep it out of version
# control. Alongside it, the incremental typecheck cache.
next-env.d.ts
*.tsbuildinfo

# This repository is public: no secret may ever be committed.
# Runtime configuration arrives through Dokploy environment variables.
.env
.env.*
*.pem
*.key

# Written by `infisical init`. Holds the vault workspace id, which is a resource
# identifier and has no place in a public repository: it arrives through
# INFISICAL_PROJECT_ID instead.
.infisical.json

# Impeccable is installed once per project, and what its install writes is
# versioned: the skill copy, its review agents, and the hook in
# .claude/settings.json. What stays out belongs to a machine or a session: the
# hook consent and cache, and the mockups, review captures, builds and live
# sessions a design session leaves behind.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/mocks/
**/.impeccable/review/
**/.impeccable/build/
**/.impeccable/live/

# Spec Kit artifacts live in the feature's GitHub issue: what a step reads and
# writes locally is a cache rebuilt from the issue (see speckit/extensions/
# issue-sync), never a second source.
.specify/tmp/
.specify/assessments/
.specify/bugs/

# What the Spec Kit CLI writes for one machine: catalog caches, the backups an
# extension update takes, local config overrides, workflow runs. The registries
# (.specify/*/.registry) and the .specify-dev outputs stay versioned: the
# maintenance commands read the first, and the skills of a --dev extension are
# symlinks into the second.
.specify/**/.cache/
.specify/extensions/.backup/
.specify/extensions/*/*.local.yml
.specify/workflows/runs/

# Claude Code's per-person settings.
.claude/settings.local.json

# Local noise
*.log
.DS_Store
